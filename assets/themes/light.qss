QWidget { background: #f4f6fa; color: #1b2433; font-family: "DejaVu Sans"; font-size: 10pt; }
QMainWindow { background: #f4f6fa; }
QLabel { background: transparent; border: none; padding: 0; }
QLabel#brand { color: #13856a; font-size: 17px; font-weight: bold; padding: 22px 12px; }
QLabel#title { font-size: 28px; font-weight: bold; color: #101826; }
QLabel#sectionTitle { font-size: 16px; font-weight: bold; }
QLabel#muted, QLabel#subtitle { color: #56657a; font-size: 12px; }
QLabel#feedback { color: #13785f; }
QLabel#warning { color: #9a5b00; }
QLabel#status { color: #1d5fa6; font-size: 21px; font-weight: bold; }
QLabel#status[attention="true"], QLabel#subtitle[attention="true"] { color: #9a5b00; }
QLabel#cardTitle { color: #56657a; font-size: 12px; }
QLabel#cardValue { color: #101826; font-size: 30px; font-weight: bold; }
QFrame#card { background: #ffffff; border: 1px solid #d8dee8; border-radius: 12px; }
QWidget#scanButtons { background: transparent; }
QCheckBox { background: transparent; }
QListWidget { background: #f0f3f8; border: none; border-radius: 8px; outline: none; }
QListWidget::item { padding: 9px 12px; border-radius: 6px; }
QListWidget::item:selected { background: #cdeee2; color: #0d4f3f; }
QListWidget::item:hover { background: #e3e9f2; }
QListWidget#sidebar { background: transparent; font-size: 13px; }
QListWidget#sidebar::item { padding: 13px 12px; margin: 3px 0; }
QPushButton { background: #ffffff; border: 1px solid #c3ccd9; border-radius: 7px; padding: 9px 15px; min-height: 19px; font-weight: bold; }
QPushButton:hover { background: #eef2f8; border-color: #8a9bb3; }
QPushButton:pressed { background: #e1e7f0; }
QPushButton#primary { background: #14876b; color: #ffffff; border-color: #14876b; }
QPushButton#primary:hover { background: #0f725a; }
QPushButton#danger { background: #fdecef; color: #a3283b; border-color: #efb7c0; }
QPushButton:disabled { background: #eceff4; color: #8b97a8; border-color: #d8dee8; }
QPushButton:focus, QCheckBox:focus, QComboBox:focus { border: 1px solid #14876b; }
QCheckBox { spacing: 10px; padding: 5px 0; font-weight: bold; }
QCheckBox::indicator { width: 19px; height: 19px; border: 1px solid #8a9bb3; border-radius: 5px; background: #ffffff; }
QCheckBox::indicator:checked { background: #14876b; border: 4px solid #bfe6d8; }
QLineEdit, QComboBox, QPlainTextEdit { background: #ffffff; border: 1px solid #c3ccd9; border-radius: 7px; padding: 9px; min-height: 19px; }
QLineEdit:focus { border-color: #14876b; }
QComboBox QAbstractItemView { background: #ffffff; selection-background-color: #cdeee2; selection-color: #0d4f3f; }
QProgressBar { background: #e4e9f1; border: 1px solid #d8dee8; border-radius: 6px; min-height: 16px; text-align: center; font-size: 11px; }
QProgressBar::chunk { background: #4fb898; border-radius: 5px; }
QTableWidget { background: #ffffff; alternate-background-color: #f5f7fb; gridline-color: #e1e6ee; border: 1px solid #d8dee8; border-radius: 7px; selection-background-color: #cdeee2; selection-color: #0d4f3f; }
QTableWidget::item { padding: 6px; }
QHeaderView::section { background: #e9eef5; padding: 10px; color: #3c4a5e; border: none; font-weight: bold; }
QScrollArea { border: none; }
QScrollBar:vertical { background: transparent; width: 9px; }
QScrollBar::handle:vertical { background: #b9c4d3; border-radius: 4px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QToolTip { background: #ffffff; color: #1b2433; border: 1px solid #c3ccd9; padding: 5px; }

QPushButton#danger:disabled, QPushButton#primary:disabled { background: #eceff4; color: #8b97a8; border-color: #d8dee8; }
QLabel#settingLabel { font-weight: bold; }
